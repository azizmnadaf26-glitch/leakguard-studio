# LeakGuard Studio - Environment Configuration
# Copy this file to .env and fill in the values for your environment.

# Database
# Provide a PostgreSQL connection string (e.g. from Render, Supabase, Neon)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# External APIs
# Groq API Key for AI operations (llama3)
GROQ_API_KEY=gsk_placeholder_key_here

# Algorand Escrow & Smart Contracts
# 24-word mnemonic for the platform's custodial escrow wallet
PLATFORM_MNEMONIC="word1 word2 word3 ... word24"
# Network configuration (testnet or mainnet)
ALGORAND_NETWORK=testnet

# x402 Payment Configuration
# The AVM address where x402 payments should be sent (can be the same as PLATFORM_MNEMONIC address or different)
AVM_ADDRESS=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# The x402 Facilitator URL
FACILITATOR_URL=https://facilitator.goplausible.xyz

# CORS / Frontend
# The URL where your React frontend is hosted (e.g., https://your-project.vercel.app)
FRONTEND_URL=http://localhost:5173
